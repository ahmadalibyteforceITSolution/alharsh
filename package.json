{
  "name": "al-hrsh-ecommerce",
  "version": "1.0.0",
  "description": "AL-HRSH E-Commerce Website - Sanitary, Electrical & Hardware Products with Admin Dashboard",
  "main": "server/src/server.js",
  "scripts": {
    "dev:server": "node server/src/server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "seed": "node server/src/seeds/seedData.js",
    "start": "node server/src/server.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": ["ecommerce", "vue", "mongodb", "express", "sanitary", "electrical", "hardware", "al-hrsh"],
  "author": "AL-HRSH Team",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
